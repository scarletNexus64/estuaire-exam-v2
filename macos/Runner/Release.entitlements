<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Sans ces droits, le sélecteur de fichiers ne s'ouvre pas :
	     export et import de la base seraient impossibles. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Serveur d'épreuves : les étudiants s'y connectent depuis le réseau
	     local. Sans ce droit en release, aucune connexion n'aboutit. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
